{
  "ontology": {
    "version": "1.0",
    "concepts": {
      "Customer": {
        "type": "EntityType",
        "description": "Customer entity in the system",
        "identify_by": ["customer_id"],
        "ai_context": {
          "synonyms": ["Client", "Buyer"]
        }
      },
      "Order": {
        "type": "EntityType",
        "description": "Customer order transaction",
        "identify_by": ["order_id"]
      },
      "Amount": {
        "type": "ValueType",
        "description": "Monetary value"
      }
    },
    "roles": {
      "placedBy": {
        "domain": "Order",
        "range": "Customer",
        "description": "Order placed by a customer"
      }
    }
  },
  "ontology_mappings": {
    "Customer": {
      "dataset": "ds_customers",
      "field_mappings": {
        "customer_id": "cust_id",
        "name": "cust_name"
      }
    },
    "Order": {
      "dataset": "ds_orders",
      "field_mappings": {
        "order_id": "id",
        "total_amount": "amount"
      }
    }
  },
  "semantic_model": {
    "datasets": {
      "ds_customers": {
        "source": "database.public.customers",
        "fields": {
          "cust_id": { "type": "STRING", "primary_key": true },
          "cust_name": { "type": "STRING" }
        }
      },
      "ds_orders": {
        "source": "database.public.orders",
        "fields": {
          "id": { "type": "STRING", "primary_key": true },
          "cust_id": { "type": "STRING" },
          "amount": { "type": "DECIMAL" }
        }
      }
    },
    "relationships": {
      "order_to_customer": {
        "left_dataset": "ds_orders",
        "right_dataset": "ds_customers",
        "join_type": "many_to_one",
        "condition": "ds_orders.cust_id = ds_customers.cust_id"
      }
    },
    "metrics": {
      "total_order_amount": {
        "dataset": "ds_orders",
        "expression": "SUM(amount)",
        "description": "Total amount of all orders"
      }
    }
  }
}
