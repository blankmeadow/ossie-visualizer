# Copy to .env and edit as needed. All settings are optional.

# Storage --------------------------------------------------------------------
KIDVOCAB_DATABASE_URL=sqlite:///./kidvocab.db
# KIDVOCAB_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/kidvocab
KIDVOCAB_MEDIA_ROOT=./media

# AI -------------------------------------------------------------------------
# mock      = fully offline, reads .txt uploads and built-in fixture pages
# anthropic = real Vision LLM OCR + extraction
KIDVOCAB_AI_PROVIDER=mock
# KIDVOCAB_ANTHROPIC_API_KEY=sk-ant-...
KIDVOCAB_ANTHROPIC_MODEL=claude-opus-5
KIDVOCAB_AI_MAX_IMAGES_PER_IMPORT=10

# Learning -------------------------------------------------------------------
KIDVOCAB_DEFAULT_DAILY_GOAL=20

# Commercial (section 45.3) --------------------------------------------------
# Used once, when an account is created. Change it freely; existing accounts
# keep the grant they were given.
KIDVOCAB_FREE_AI_IMAGE_IMPORT_QUOTA=3
